<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - TiendaOnline</title>
    @Styles.Render("~/Content/css")
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body {
            padding-top: 56px;
            background-color: #f8f9fa;
        }

        /* Offcanvas cart panel */
        .cart-offcanvas {
            position: fixed;
            top: 0;
            right: -420px;
            width: 420px;
            height: 100vh;
            background: #fff;
            z-index: 1060;
            box-shadow: -4px 0 20px rgba(0,0,0,0.15);
            transition: right 0.35s ease;
            display: flex;
            flex-direction: column;
        }

        .cart-offcanvas.show {
            right: 0;
        }

        .cart-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.4);
            z-index: 1055;
            display: none;
        }

        .cart-overlay.show {
            display: block;
        }

        .cart-header {
            padding: 1rem 1.25rem;
            border-bottom: 1px solid #dee2e6;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #212529;
            color: #fff;
        }

        .cart-body {
            flex: 1;
            overflow-y: auto;
            padding: 1rem;
        }

        .cart-footer {
            border-top: 1px solid #dee2e6;
            padding: 1rem 1.25rem;
            background: #f8f9fa;
        }

        .cart-item {
            display: flex;
            align-items: center;
            padding: 0.75rem 0;
            border-bottom: 1px solid #eee;
        }

        .cart-item-info {
            flex: 1;
            margin-left: 0.5rem;
        }

        .cart-item-name {
            font-weight: 600;
            font-size: 0.9rem;
            margin-bottom: 0.2rem;
        }

        .cart-item-price {
            color: #6c757d;
            font-size: 0.85rem;
        }

        .cart-item-qty {
            display: flex;
            align-items: center;
            gap: 0.35rem;
        }

        .cart-item-qty .btn {
            width: 28px;
            height: 28px;
            padding: 0;
            font-size: 0.8rem;
            line-height: 28px;
        }

        .cart-item-qty span {
            min-width: 24px;
            text-align: center;
            font-weight: 600;
        }

        .cart-item-subtotal {
            font-weight: 700;
            color: #212529;
            min-width: 70px;
            text-align: right;
        }

        .cart-item-remove {
            margin-left: 0.5rem;
        }

        .badge-cart {
            position: absolute;
            top: -4px;
            right: -6px;
            font-size: 0.65rem;
            padding: 3px 6px;
        }

        .nav-cart-btn {
            position: relative;
            display: inline-block;
        }

        .cart-empty-msg {
            text-align: center;
            padding: 3rem 1rem;
            color: #adb5bd;
        }

        .cart-empty-msg i {
            font-size: 3rem;
            margin-bottom: 1rem;
            display: block;
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
        <div class="container">
            <a class="navbar-brand fw-bold" href="@Url.Action("Index", "Tienda")">
                <i class="fas fa-store me-2"></i>TiendaOnline
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Tienda")">
                            <i class="fas fa-th-large me-1"></i>Catalogo
                        </a>
                    </li>
                </ul>
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item me-3">
                        <a href="javascript:void(0)" class="nav-link nav-cart-btn" id="btnAbrirCarrito">
                            <i class="fas fa-shopping-cart fa-lg"></i>
                            <span class="badge bg-danger rounded-pill badge-cart" id="badgeCarrito">0</span>
                        </a>
                    </li>
                    @if (Session["NombreCliente"] != null)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-user-circle me-1"></i>@Session["NombreCliente"]
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                <li><a class="dropdown-item" href="@Url.Action("CerrarSesion", "Acceso")"><i class="fas fa-sign-out-alt me-2"></i>Cerrar Sesion</a></li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="btn btn-outline-light btn-sm" href="@Url.Action("Index", "Acceso")">
                                <i class="fas fa-sign-in-alt me-1"></i>Iniciar Sesion
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Cart Overlay -->
    <div class="cart-overlay" id="cartOverlay"></div>

    <!-- Cart Offcanvas Panel -->
    <div class="cart-offcanvas" id="cartPanel">
        <div class="cart-header">
            <h5 class="mb-0"><i class="fas fa-shopping-cart me-2"></i>Mi Carrito</h5>
            <button type="button" class="btn btn-sm btn-outline-light" id="btnCerrarCarrito">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="cart-body" id="cartBody">
            <div class="cart-empty-msg" id="cartEmpty">
                <i class="fas fa-shopping-basket"></i>
                <p>Tu carrito esta vacio</p>
            </div>
            <div id="cartItems"></div>
        </div>
        <div class="cart-footer">
            <div class="d-flex justify-content-between mb-3">
                <span class="fw-bold fs-5">Total:</span>
                <span class="fw-bold fs-5 text-success" id="cartTotal">$0.00</span>
            </div>
            <a href="@Url.Action("Checkout", "Tienda")" class="btn btn-success w-100 fw-bold" id="btnProcederPago">
                <i class="fas fa-credit-card me-2"></i>Proceder al Pago
            </a>
        </div>
    </div>

    <!-- Main Content -->
    <div class="container mt-4">
        @RenderBody()
    </div>

    <footer class="py-4 bg-dark text-white mt-5">
        <div class="container">
            <div class="d-flex align-items-center justify-content-between small">
                <div>Copyright &copy; Angel Sanchez @DateTime.Now.Year</div>
                <div>
                    <a href="#" class="text-white-50">Politica de Privacidad</a>
                    &middot;
                    <a href="#" class="text-white-50">Terminos y Condiciones</a>
                </div>
            </div>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

    <script>
        // ===== Cart Panel Logic =====
        function abrirCarrito() {
            $("#cartPanel").addClass("show");
            $("#cartOverlay").addClass("show");
            cargarCarrito();
        }

        function cerrarCarrito() {
            $("#cartPanel").removeClass("show");
            $("#cartOverlay").removeClass("show");
        }

        $("#btnAbrirCarrito").on("click", function () {
            abrirCarrito();
        });

        $("#btnCerrarCarrito, #cartOverlay").on("click", function () {
            cerrarCarrito();
        });

        // Load cart count
        function actualizarBadgeCarrito() {
            $.ajax({
                url: '@Url.Action("ContarCarrito", "Tienda")',
                type: 'GET',
                dataType: 'json',
                success: function (data) {
                    var cant = data.cantidad || 0;
                    $("#badgeCarrito").text(cant);
                    if (cant > 0) {
                        $("#badgeCarrito").show();
                    } else {
                        $("#badgeCarrito").hide();
                    }
                }
            });
        }

        // Load cart items into panel
        function cargarCarrito() {
            $.ajax({
                url: '@Url.Action("ListarCarrito", "Tienda")',
                type: 'GET',
                dataType: 'json',
                success: function (data) {
                    var items = data.data;
                    var html = "";
                    var total = 0;

                    if (items.length === 0) {
                        $("#cartEmpty").show();
                        $("#cartItems").html("");
                        $("#cartTotal").text("$0.00");
                        $("#btnProcederPago").addClass("disabled");
                        return;
                    }

                    $("#cartEmpty").hide();
                    $("#btnProcederPago").removeClass("disabled");

                    $.each(items, function (i, item) {
                        var subtotal = item.SubTotal;
                        total += subtotal;

                        html += '<div class="cart-item" data-id="' + item.IdCarrito + '">';
                        html += '  <div class="cart-item-info">';
                        html += '    <div class="cart-item-name">' + item.Nombre + '</div>';
                        html += '    <div class="cart-item-price">$' + item.Precio.toFixed(2) + '</div>';
                        html += '  </div>';
                        html += '  <div class="cart-item-qty">';
                        html += '    <button class="btn btn-outline-secondary btn-sm btn-qty-minus" data-id="' + item.IdCarrito + '" data-cant="' + item.Cantidad + '"><i class="fas fa-minus"></i></button>';
                        html += '    <span>' + item.Cantidad + '</span>';
                        html += '    <button class="btn btn-outline-secondary btn-sm btn-qty-plus" data-id="' + item.IdCarrito + '" data-cant="' + item.Cantidad + '" data-stock="' + item.Stock + '"><i class="fas fa-plus"></i></button>';
                        html += '  </div>';
                        html += '  <div class="cart-item-subtotal">$' + subtotal.toFixed(2) + '</div>';
                        html += '  <div class="cart-item-remove">';
                        html += '    <button class="btn btn-sm btn-outline-danger btn-cart-remove" data-id="' + item.IdCarrito + '"><i class="fas fa-times"></i></button>';
                        html += '  </div>';
                        html += '</div>';
                    });

                    $("#cartItems").html(html);
                    $("#cartTotal").text("$" + total.toFixed(2));
                }
            });
        }

        // Quantity minus
        $(document).on("click", ".btn-qty-minus", function () {
            var idCarrito = $(this).data("id");
            var cant = $(this).data("cant");
            if (cant <= 1) return;
            $.ajax({
                url: '@Url.Action("ModificarCarrito", "Tienda")',
                type: 'POST',
                data: { idCarrito: idCarrito, cantidad: cant - 1 },
                dataType: 'json',
                success: function (data) {
                    if (data.resultado) {
                        cargarCarrito();
                        actualizarBadgeCarrito();
                    }
                }
            });
        });

        // Quantity plus
        $(document).on("click", ".btn-qty-plus", function () {
            var idCarrito = $(this).data("id");
            var cant = $(this).data("cant");
            var stock = $(this).data("stock");
            if (cant >= stock) return;
            $.ajax({
                url: '@Url.Action("ModificarCarrito", "Tienda")',
                type: 'POST',
                data: { idCarrito: idCarrito, cantidad: cant + 1 },
                dataType: 'json',
                success: function (data) {
                    if (data.resultado) {
                        cargarCarrito();
                        actualizarBadgeCarrito();
                    }
                }
            });
        });

        // Remove item
        $(document).on("click", ".btn-cart-remove", function () {
            var idCarrito = $(this).data("id");
            $.ajax({
                url: '@Url.Action("EliminarCarrito", "Tienda")',
                type: 'POST',
                data: { idCarrito: idCarrito },
                dataType: 'json',
                success: function (data) {
                    if (data.resultado) {
                        cargarCarrito();
                        actualizarBadgeCarrito();
                    }
                }
            });
        });

        // Initial badge load
        $(document).ready(function () {
            actualizarBadgeCarrito();
        });
    </script>

    @RenderSection("scripts", required: false)
</body>
</html>
