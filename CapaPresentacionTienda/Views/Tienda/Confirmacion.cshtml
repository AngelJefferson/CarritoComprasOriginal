@{
    ViewBag.Title = "Confirmacion";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .confirmation-icon {
        font-size: 5rem;
        color: #198754;
        animation: scaleIn 0.5s ease;
    }

    @@keyframes scaleIn {
        0% { transform: scale(0); opacity: 0; }
        100% { transform: scale(1); opacity: 1; }
    }

    .transaction-badge {
        font-size: 1.1rem;
        letter-spacing: 1px;
    }
</style>

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <!-- Success Header -->
        <div class="text-center mb-4">
            <div class="confirmation-icon">
                <i class="fas fa-check-circle"></i>
            </div>
            <h2 class="mt-3 fw-bold">Compra realizada con exito!</h2>
            <p class="text-muted fs-5">Gracias por tu compra. Tu pedido ha sido procesado correctamente.</p>
            <div class="mt-2">
                <span class="badge bg-dark transaction-badge px-3 py-2">
                    <i class="fas fa-hashtag me-1"></i>Transaccion: <span id="txtTransaccion">@ViewBag.IdTransaccion</span>
                </span>
            </div>
        </div>

        <div id="loadingConfirmacion" class="text-center py-4">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Cargando detalles...</p>
        </div>

        <div id="detalleConfirmacion" style="display:none;">
            <!-- Order Details -->
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-dark text-white fw-bold">
                    <i class="fas fa-box me-1"></i>Detalle del Pedido
                </div>
                <div class="card-body">
                    <table class="table mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Producto</th>
                                <th class="text-center">Precio</th>
                                <th class="text-center">Cantidad</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody id="detalleBody"></tbody>
                        <tfoot>
                            <tr class="table-success">
                                <th colspan="3" class="text-end">Total Pagado:</th>
                                <th class="text-end fs-5" id="detalleTotal"></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <!-- Shipping Info -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-dark text-white fw-bold">
                    <i class="fas fa-truck me-1"></i>Informacion de Envio
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p class="mb-1"><strong><i class="fas fa-user me-1"></i>Contacto:</strong></p>
                            <p class="text-muted" id="infoContacto"></p>
                        </div>
                        <div class="col-md-6">
                            <p class="mb-1"><strong><i class="fas fa-phone me-1"></i>Telefono:</strong></p>
                            <p class="text-muted" id="infoTelefono"></p>
                        </div>
                        <div class="col-md-6">
                            <p class="mb-1"><strong><i class="fas fa-map-marker-alt me-1"></i>Direccion:</strong></p>
                            <p class="text-muted" id="infoDireccion"></p>
                        </div>
                        <div class="col-md-6">
                            <p class="mb-1"><strong><i class="fas fa-calendar me-1"></i>Fecha:</strong></p>
                            <p class="text-muted" id="infoFecha"></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Back to Store -->
        <div class="text-center mb-5">
            <a href="@Url.Action("Index", "Tienda")" class="btn btn-dark btn-lg px-5">
                <i class="fas fa-store me-2"></i>Volver a la tienda
            </a>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            var idTransaccion = "@ViewBag.IdTransaccion";

            if (!idTransaccion) {
                window.location.href = '@Url.Action("Index", "Tienda")';
                return;
            }

            $.ajax({
                url: '@Url.Action("ObtenerVenta", "Tienda")',
                type: 'GET',
                data: { idTransaccion: idTransaccion },
                dataType: 'json',
                success: function (data) {
                    $("#loadingConfirmacion").hide();

                    if (!data.venta) {
                        $("#detalleConfirmacion").html('<div class="alert alert-warning text-center">No se encontraron datos de la venta.</div>').show();
                        return;
                    }

                    // Venta info
                    $("#infoContacto").text(data.venta.Contacto);
                    $("#infoTelefono").text(data.venta.Telefono);
                    $("#infoDireccion").text(data.venta.Direccion);
                    $("#infoFecha").text(data.venta.FechaTexto || "N/A");
                    $("#detalleTotal").text("$" + data.venta.MontoTotal.toFixed(2));

                    // Detalle products
                    var html = "";
                    $.each(data.detalle, function (i, d) {
                        html += '<tr>';
                        html += '  <td>' + d.Nombre + '</td>';
                        html += '  <td class="text-center">$' + d.Precio.toFixed(2) + '</td>';
                        html += '  <td class="text-center">' + d.Cantidad + '</td>';
                        html += '  <td class="text-end fw-bold">$' + d.Total.toFixed(2) + '</td>';
                        html += '</tr>';
                    });

                    $("#detalleBody").html(html);
                    $("#detalleConfirmacion").show();
                },
                error: function () {
                    $("#loadingConfirmacion").hide();
                    $("#detalleConfirmacion").html('<div class="alert alert-danger text-center">Error al cargar los detalles.</div>').show();
                }
            });
        });
    </script>
}
